# Generated build trees and packaged artifacts live below hidden roots.
.build/
.artifacts/
.third_party/
.scratch/

# Keep legacy root-level generated paths ignored for existing checkouts.
build/
build-*/
dist/
*.app/
*.AppImage
.DS_Store

# Local runtime files
downloads/
venv/
*.log
*.pid

# Optional Android runtime dependencies are staged into the package source
# only for local/CI builds; the large AARs are fetched and verified separately.
android/libs/*.aar
android/libs/*.jar
